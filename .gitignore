# فایل تنظیمات حاوی رمزها (روی هاست ساخته می‌شود، در گیت نباشد)
config/config.local.php
.env

# فایل‌های آپلودی کاربران — خود پوشه بماند، محتوایش نه
uploads/*
!uploads/.htaccess
!uploads/products/
uploads/products/*
!uploads/products/.gitkeep
!uploads/branding/
uploads/branding/*
!uploads/branding/.gitkeep
!uploads/banners/
uploads/banners/*
!uploads/banners/.gitkeep
!uploads/categories/
uploads/categories/*
!uploads/categories/.gitkeep
!uploads/posts/
uploads/posts/*
!uploads/posts/.gitkeep

# لاگ‌ها — خود پوشه بماند تا PHP بتواند در آن بنویسد
logs/*
!logs/.htaccess
!logs/.gitkeep

# فایل‌های موقت
tmp/
*.log

# فایل‌های سیستمی
.DS_Store
Thumbs.db

# ادیتورها
.idea/
.vscode/
*.swp

# ابزارهای توسعه (در این پروژه استفاده نمی‌شوند)
node_modules/
vendor/
